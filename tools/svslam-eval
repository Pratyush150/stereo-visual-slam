#!/usr/bin/env python3
"""Score a saved trajectory against KITTI ground truth.

Reads two files in the KITTI odometry pose format (twelve numbers per line) --
or reads the ground truth straight from a sequence directory -- and reports the
official KITTI translation and rotation errors plus ATE and RPE.

Examples::

    tools/svslam-eval --estimate trajectory.txt --sequence /data/kitti/sequences/07
    tools/svslam-eval --estimate trajectory.txt --ground-truth poses/07.txt --json out.json
"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

import numpy as np

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))

from svslam.dataset.kitti import open_sequence  # noqa: E402
from svslam.evaluation.kitti_metrics import evaluate  # noqa: E402


def load_poses(path: str | Path) -> np.ndarray:
    """Read a KITTI-format pose file into ``(N, 4, 4)``."""
    flat = np.loadtxt(path)
    if flat.ndim == 1:
        flat = flat.reshape(1, -1)
    if flat.shape[1] != 12:
        raise ValueError(f"{path}: expected 12 numbers per line, found {flat.shape[1]}")
    poses = np.tile(np.eye(4), (flat.shape[0], 1, 1))
    poses[:, :3, :4] = flat.reshape(-1, 3, 4)
    return poses


def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("--estimate", required=True, help="estimated trajectory file")
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument("--ground-truth", help="ground-truth pose file")
    group.add_argument("--sequence", help="sequence directory to take ground truth from")
    parser.add_argument("--calib", default=None, help="calibration directory (raw layout only)")
    parser.add_argument("--json", default=None, help="also write the report as JSON")
    parser.add_argument("--rpe-delta", type=int, default=10,
                        help="frame gap for the relative pose error")
    parser.add_argument("--align-scale", action="store_true",
                        help="also solve for scale in the ATE alignment (monocular case)")
    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    args = parse_args(argv)
    estimate = load_poses(args.estimate)

    if args.ground_truth:
        ground_truth = load_poses(args.ground_truth)
    else:
        kwargs = {"calib_dir": args.calib} if args.calib else {}
        dataset = open_sequence(args.sequence, **kwargs)
        ground_truth = dataset.ground_truth()
        if ground_truth is None:
            print(f"{args.sequence}: no ground truth available", file=sys.stderr)
            return 2

    n = min(len(estimate), len(ground_truth))
    if n == 0:
        print("nothing to compare", file=sys.stderr)
        return 2
    if len(estimate) != len(ground_truth):
        print(f"note: comparing the first {n} poses "
              f"({len(estimate)} estimated, {len(ground_truth)} ground truth)")

    report = evaluate(
        estimate[:n], ground_truth[:n],
        rpe_delta=args.rpe_delta, ate_with_scale=args.align_scale,
    )

    print()
    print(f"poses compared     : {report.n_poses}")
    print(f"ground-truth path  : {report.path_length:.1f} m")
    if report.n_segments == 0:
        print("translation error  : not defined")
        print("rotation error     : not defined")
        print(f"sub-sequences used : 0 -- the trajectory is shorter than the "
              f"benchmark's smallest sub-sequence (100 m), so the KITTI metric "
              f"has nothing to average.\n"
              f"                     Use ATE and RPE below, or evaluate a "
              f"longer slice.")
    else:
        print(f"translation error  : {report.translation_percent:.3f} %")
        print(f"rotation error     : {report.rotation_deg_per_m:.5f} deg/m")
        print(f"sub-sequences used : {report.n_segments}")
    print(f"ATE RMSE           : {report.ate['rmse']:.3f} m "
          f"(mean {report.ate['mean']:.3f}, median {report.ate['median']:.3f}, "
          f"max {report.ate['max']:.3f})")
    if args.align_scale:
        print(f"fitted scale       : {report.ate['scale']:.4f}")
    print(f"RPE ({args.rpe_delta:d} frames)   : {report.rpe['translation_rmse']:.4f} m, "
          f"{report.rpe['rotation_rmse_deg']:.4f} deg")
    print()
    print(report.format_table())

    if args.json:
        Path(args.json).write_text(json.dumps(report.as_dict(), indent=2), encoding="utf-8")
        print(f"\nwrote {args.json}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
